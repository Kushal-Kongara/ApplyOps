# ApplyOps environment settings (Phase 1).
# Copy to .env and adjust. Never commit the real .env file.

# Path to the SQLite database used by `python -m app.cli`.
APPLYOPS_DB_PATH=data/applyops.db

# Path to your private source configuration file.
APPLYOPS_SOURCES_PATH=config/sources.json

# Used by the API server (backend/app/api.py) only — the CLI takes these as
# --db / --profile flags instead. Uncomment and edit if you want the API to
# read a database, profile, master resume, or resume-output directory
# somewhere other than the API's own defaults.
# APPLYOPS_DB_PATH=data/applyops.db
# APPLYOPS_PROFILE_PATH=config/profile.json
# APPLYOPS_MASTER_RESUME_PATH=config/resume_master.json
# APPLYOPS_RESUMES_ROOT=data/resumes
# APPLYOPS_APPLICANT_PROFILE_PATH=config/applicant_profile.json

# --- LLM-enhanced resume rewriting (optional) --------------------------------
#
# Unset by default: deterministic resume generation works with none of this
# configured. Only set these if you have a local Ollama server (e.g. running
# on a DGX on your own network) and want the "DGX Enhanced" resume option.
# Never commit real values here — placeholders only.
#
# APPLYOPS_LLM_PROVIDER=ollama
# APPLYOPS_OLLAMA_BASE_URL=http://<your-ollama-host>:11434
# APPLYOPS_OLLAMA_MODEL=<model-name-already-installed-on-that-host>
# APPLYOPS_LLM_TIMEOUT_SECONDS=30
