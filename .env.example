# ApplyOps environment settings (Phase 1).
# Copy to .env and adjust. Never commit the real .env file.

# Path to the SQLite database used by `python -m app.cli`.
APPLYOPS_DB_PATH=data/applyops.db

# Path to your private source configuration file.
APPLYOPS_SOURCES_PATH=config/sources.json

# Used by the API server (backend/app/api.py) only — the CLI takes these as
# --db / --profile flags instead. Uncomment and edit if you want the API to
# read a database or profile somewhere other than the CLI's own defaults.
# APPLYOPS_DB_PATH=data/applyops.db
# APPLYOPS_PROFILE_PATH=config/profile.json
